<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wire.autologin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="users_setting_container" position="after">
                <block title="Authelia-Anmeldung" name="wire_autologin_setting_container">
                    <setting id="wire_autologin_mode_setting" string="Zuordnung"
                             help="Wie ein Authelia-Benutzer der Gruppe eco einem Odoo-Benutzer zugeordnet wird">
                        <field name="wire_autologin_mode" widget="radio"/>
                        <div invisible="wire_autologin_mode != 'table'">
                            <button name="%(wire_autologin_mapping_action)d" type="action" string="Zuordnungstabelle"
                                    icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
