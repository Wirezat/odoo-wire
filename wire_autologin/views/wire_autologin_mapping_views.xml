<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wire_autologin_mapping_view_list" model="ir.ui.view">
        <field name="name">wire.autologin.mapping.list</field>
        <field name="model">wire.autologin.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="remote_user"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="wire_autologin_mapping_action" model="ir.actions.act_window">
        <field name="name">Authelia-Zuordnung</field>
        <field name="res_model">wire.autologin.mapping</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="wire_autologin_mapping_menu" action="wire_autologin_mapping_action" parent="base.menu_users"
              groups="base.group_system" sequence="50"/>
</odoo>
